<?xml version="1.0"?>
<Container version="2">
  <Name>PasswordCheckerWeb</Name>
  <Repository>hardly007/password-checker-web:latest</Repository>
  <Registry>https://hub.docker.com/r/hardly007/password-checker-web</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/JPetovello/password-checker-web/issues</Support>
  <Project>https://github.com/JPetovello/password-checker-web</Project>
  <Overview>A lightweight, security-focused web application designed to evaluate password strength, generate secure passphrases, and verify credentials against breach databases.</Overview>
  <Category>Security: Status:Stable</Category>
  <WebUI>http://[IP]:[PORT:5000]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/JPetovello/unraid-templates/main/password-checker-web.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/JPetovello/password-checker-web/main/static/icon.png</Icon>
  <ExtraParams/>
  <DateInstalled></DateInstalled>
  <Description>Password evaluation, passphrase generation, and k-Anonymity breach checking.</Description>
  <Config Name="WebUI Port" Target="5000" Default="5000" Mode="tcp" Description="Container Web Port" Type="Port" Display="always" Required="true" Mask="false">5000</Config>
  <Config Name="Deployment Source" Target="APP_SOURCE" Default="unraid_ca" Mode="" Description="Identifies launch source for analytics" Type="Variable" Display="always-hide" Required="false" Mask="false">unraid_ca</Config>
  <Config Name="Discord Webhook URL" Target="DISCORD_WEBHOOK_URL" Default="" Mode="" Description="Optional webhook for startup alerts" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Disable Telemetry" Target="DISABLE_TELEMETRY" Default="false" Mode="" Description="Set to 'true' to disable anonymous startup telemetry metrics." Type="Variable" Display="always" Required="false" Mask="false">false</Config>
</Container>
