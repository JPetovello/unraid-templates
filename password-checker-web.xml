<?xml version="1.0"?>
<Container version="2">
  <Name>password-checker-web</Name>
  <Repository>hardly007/password-checker-web:latest</Repository>
  <Registry>https://hub.docker.com/r/hardly007/password-checker-web</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/JPetovello/password-checker-web/issues</Support>
  <Project>https://github.com/JPetovello/password-checker-web</Project>
  <Overview>A lightweight Flask web application to evaluate password strength.</Overview>
  <Category>Tools: Security:</Category>
  <WebUI>http://[IP]:[PORT:5000]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/JPetovello/unraid-templates/main/password-checker-web.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/JPetovello/unraid-templates/main/icon.png</Icon>
  <Config Name="WebUI Port" Target="5000" Default="5000" Mode="" Description="Web interface port" Type="Port" Display="always" Required="true" Mask="false">5000</Config>
</Container>
