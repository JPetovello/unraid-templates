<?xml version="1.0"?>
<Container version="2">
  <Name>PasswordCheckerWeb</Name>
  <Repository>hardly007/password-checker-web:latest</Repository>
  <Registry>https://hub.docker.com/r/hardly007/password-checker-web</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/JPetovello/password-checker-web/issues</Support>
  <Project>https://github.com/JPetovello/password-checker-web</Project>
  <Overview>Password Checker Web is a lightweight, self-hosted web tool that tests password strength, complexity, and policy compliance locally. Designed with privacy as a priority, all password analysis runs entirely on your server with zero telemetry or external API calls, keeping your sensitive credentials 100% private.</Overview>
  <Category>Security: Tools:</Category>
  <WebUI>http://[IP]:[PORT:5000]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/JPetovello/unraid-templates/main/password-checker-web.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/JPetovello/unraid-templates/main/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI" Target="5000" Default="5000" Mode="tcp" Description="Web interface port" Type="WebUI" Display="always" Required="true">5000</Config>
  <Config Name="Timezone" Mode="" Purpose="" Required="false" Mask="false" Description="Container timezone" Type="Variable" Target="TZ" Default="America/Toronto">America/Toronto</Config>
</Container>
