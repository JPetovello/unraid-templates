<?xml version="1.0"?>
<Container version="2">
  <Name>PasswordCheckerWeb</Name>
  <Repository>hardly007/password-checker-web:latest</Repository>
  <Registry>https://hub.docker.com/r/hardly007/password-checker-web</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/JPetovello/password-checker-web/issues</Support>
  <Project>https://github.com/JPetovello/password-checker-web</Project>
  <Overview>A lightweight Flask web application that evaluates password strength using zxcvbn, checks for compromised passwords against Have I Been Pwned (HIBP) using k-Anonymity for privacy, and generates high-entropy passphrases based on the official 7,776-word EFF Large Wordlist.</Overview>
  <Category>Security: Tools:</Category>
  <WebUI>http://[IP]:[PORT:5000]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/JPetovello/unraid-templates/main/password-checker-web.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/JPetovello/unraid-templates/main/icon.png</Icon>
  <Config Name="WebUI Port" Target="5000" Default="5000" Mode="tcp" Description="Web interface port" Type="Port" Display="always" Required="true" Mask="false">5000</Config>
  <Config Name="Timezone" Target="TZ" Default="America/Toronto" Mode="" Description="Container timezone" Type="Variable" Display="always" Required="false" Mask="false">America/Toronto</Config>
</Container>
